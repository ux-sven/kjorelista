    <!-- Personvern -->
    <string name="privacy_title">Personvernserklæring</string>
    <string name="privacy_last_updated">Sist oppdatert: 8. januar 2025</string>
    <string name="privacy_introduction">Denne personvernserklæringen beskriver hvordan Kjørelista (\"vi\", \"oss\", \"vår\") samler inn, bruker og beskytter dine personopplysninger når du bruker vår kjørelogg-tjeneste.</string>
    <string name="privacy_data_controller">Behandlingsansvarlig</string>
    <string name="privacy_what_we_collect">Hvilke opplysninger vi samler inn</string>
    <string name="privacy_what_we_collect_content">Vi samler inn følgende typer opplysninger:\n\n• Kontoinformasjon: E-postadresse, fornavn og etternavn\n• Kjøredata: Datoer, distanser, ruter, reisetid, passasjerinformasjon og kommentarer\n• Teknisk informasjon: IP-adresse, nettlesertype og bruksmønster for å forbedre tjenesten\n• Cookies og lignende teknologier for å huske dine preferanser</string>
    <string name="privacy_how_we_use">Hvordan vi bruker dine opplysninger</string>
    <string name="privacy_how_we_use_content">Vi bruker dine opplysninger til å:\n\n• Tilby og drifte kjørelogg-tjenesten\n• Lagre og organisere dine kjøredata\n• Generere rapporter og eksporter\n• Gi kundestøtte og teknisk support\n• Forbedre og utvikle tjenesten\n• Kommunisere viktige oppdateringer om tjenesten</string>
    <string name="privacy_storage">Datalagring og oppbevaring</string>
    <string name="privacy_storage_content">Dine data lagres sikkert hos Supabase (cloud-modus) eller lokalt i din nettleser (demo-modus). I cloud-modus lagres data kryptert og sikres med moderne sikkerhetsprotokoller. Vi oppbevarer dine data så lenge du har en aktiv konto, eller som påkrevd av gjeldende lovgivning.</string>
    <string name="privacy_sharing">Deling av data</string>
    <string name="privacy_sharing_content">Vi deler ikke dine personopplysninger med tredjeparter, bortsett fra:\n\n• Supabase (vår leverandør av skytjenester) for datalagring\n• Når det er påkrevd av lov eller myndigheter\n• For å beskytte våre rettigheter eller andres sikkerhet\n\nVi selger aldri dine personopplysninger.</string>
    <string name="privacy_user_rights">Dine rettigheter</string>
    <string name="privacy_user_rights_content">Du har rett til å:\n\n• Få tilgang til dine personopplysninger\n• Rette feil eller mangelfulle opplysninger\n• Slette din konto og alle tilknyttede data\n• Eksportere dine data i et maskinlesbart format\n• Trekke tilbake samtykke der det er relevant\n• Klage til Datatilsynet</string>
    <string name="privacy_security">Datasikkerhet</string>
    <string name="privacy_security_content">Vi implementerer passende tekniske og organisatoriske tiltak for å beskytte dine personopplysninger mot uautorisert tilgang, endring, avsløring eller ødeleggelse. Dette inkluderer kryptering, sikre servere og regelmessige sikkerhetsoppdateringer.</string>
    <string name="privacy_cookies">Cookies og lokal lagring</string>
    <string name="privacy_cookies_content">Vi bruker cookies og lokal lagring for å:\n\n• Huske dine innloggingsopplysninger\n• Lagre språk- og temainnstillinger\n• Forbedre ytelsen til applikasjonen\n• I demo-modus: lagre alle data lokalt i nettleseren\n\nDu kan administrere cookie-innstillinger i din nettleser.</string>
    <string name="privacy_changes">Endringer i personvernserklæringen</string>
    <string name="privacy_changes_content">Vi kan oppdatere denne personvernserklæringen fra tid til annen. Vesentlige endringer vil bli kommunisert via e-post eller en merknad i applikasjonen. Vi oppfordrer deg til å lese denne erklæringen regelmessig.</string>
    <string name="privacy_contact">Kontakt oss</string>
    <string name="privacy_contact_content">Hvis du har spørsmål om denne personvernserklæringen eller ønsker å utøve dine rettigheter, kan du kontakte oss på:</string>
    <string name="settings_trip_entry">Registrering av turer</string>
    <string name="settings_route_suggestions">Forslag til strekning</string>
    <string name="settings_route_suggestions_footer">Viser strekninger du har kjørt før mens du skriver.</string>
    <string name="settings_autofill_km">Fyll inn kilometer automatisk</string>
    <string name="settings_autofill_km_footer">Når du velger et forslag, fylles kilometer inn fra forrige tur på samme strekning.</string>
