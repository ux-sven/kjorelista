    "privacy.changes" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes to this privacy policy"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringer i personvernserklæringen"
          }
        }
      }
    },
    "privacy.changesContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We may update this privacy policy from time to time. Significant changes will be communicated via email or a notice in the application. We encourage you to read this policy regularly."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kan oppdatere denne personvernserklæringen fra tid til annen. Vesentlige endringer vil bli kommunisert via e-post eller en merknad i applikasjonen. Vi oppfordrer deg til å lese denne erklæringen regelmessig."
          }
        }
      }
    },
