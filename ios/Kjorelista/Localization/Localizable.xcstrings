    "app.deleteAccountFooter": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter kontoen og alle kjøreturer permanent, også i webversjonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes your account and all trips, including on the web."
          }
        }
      }
    },
    "app.deleteAccountMessage": {
      "extractionState": "manual",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen din og alle registrerte kjøreturer slettes permanent. Dette kan ikke angres. Gjelder også webversjonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and all recorded trips will be permanently deleted. This cannot be undone and also applies to the web version."
          }
        }
      }
    },
