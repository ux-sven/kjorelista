    "privacy.cookies" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies and local storage"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies og lokal lagring"
          }
        }
      }
    },
    "privacy.cookiesContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use cookies and local storage to:\n\n• Remember your login credentials\n• Store language and theme preferences\n• Improve application performance\n• In demo mode: store all data locally in the browser\n\nYou can manage cookie settings in your browser."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi bruker cookies og lokal lagring for å:\n\n• Huske dine innloggingsopplysninger\n• Lagre språk- og temainnstillinger\n• Forbedre ytelsen til applikasjonen\n• I demo-modus: lagre alle data lokalt i nettleseren\n\nDu kan administrere cookie-innstillinger i din nettleser."
          }
        }
      }
    },
    "privacy.dataController" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Controller"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandlingsansvarlig"
          }
        }
      }
    },
    "privacy.dataHowWeUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How we use your information"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan vi bruker dine opplysninger"
          }
        }
      }
    },
    "privacy.dataHowWeUseContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use your information to:\n\n• Provide and operate the driving log service\n• Store and organize your driving data\n• Generate reports and exports\n• Provide customer support and technical assistance\n• Improve and develop the service\n• Communicate important updates about the service"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi bruker dine opplysninger til å:\n\n• Tilby og drifte kjørelogg-tjenesten\n• Lagre og organisere dine kjøredata\n• Generere rapporter og eksporter\n• Gi kundestøtte og teknisk support\n• Forbedre og utvikle tjenesten\n• Kommunisere viktige oppdateringer om tjenesten"
          }
        }
      }
    },
    "privacy.dataSecurity" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data security"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasikkerhet"
          }
        }
      }
    },
    "privacy.dataSecurityContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction. This includes encryption, secure servers, and regular security updates."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi implementerer passende tekniske og organisatoriske tiltak for å beskytte dine personopplysninger mot uautorisert tilgang, endring, avsløring eller ødeleggelse. Dette inkluderer kryptering, sikre servere og regelmessige sikkerhetsoppdateringer."
          }
        }
      }
    },
    "privacy.dataSharing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data sharing"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deling av data"
          }
        }
      }
    },
    "privacy.dataSharingContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We do not share your personal information with third parties, except:\n\n• Supabase (our cloud service provider) for data storage\n• When required by law or authorities\n• To protect our rights or others' safety\n\nWe never sell your personal information."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi deler ikke dine personopplysninger med tredjeparter, bortsett fra:\n\n• Supabase (vår leverandør av skytjenester) for datalagring\n• Når det er påkrevd av lov eller myndigheter\n• For å beskytte våre rettigheter eller andres sikkerhet\n\nVi selger aldri dine personopplysninger."
          }
        }
      }
    },
    "privacy.dataStorage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data storage and retention"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datalagring og oppbevaring"
          }
        }
      }
    },
    "privacy.dataStorageContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data is stored securely with Supabase (cloud mode) or locally in your browser (demo mode). In cloud mode, data is stored encrypted and secured with modern security protocols. We retain your data as long as you have an active account, or as required by applicable law."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data lagres sikkert hos Supabase (cloud-modus) eller lokalt i din nettleser (demo-modus). I cloud-modus lagres data kryptert og sikres med moderne sikkerhetsprotokoller. Vi oppbevarer dine data så lenge du har en aktiv konto, eller som påkrevd av gjeldende lovgivning."
          }
        }
      }
    },
    "privacy.dataWhatWeCollect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What information we collect"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke opplysninger vi samler inn"
          }
        }
      }
    },
    "privacy.dataWhatWeCollectContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We collect the following types of information:\n\n• Account information: Email address, first name, and last name\n• Driving data: Dates, distances, routes, travel time, passenger information, and comments\n• Technical information: IP address, browser type, and usage patterns to improve the service\n• Cookies and similar technologies to remember your preferences"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi samler inn følgende typer opplysninger:\n\n• Kontoinformasjon: E-postadresse, fornavn og etternavn\n• Kjøredata: Datoer, distanser, ruter, reisetid, passasjerinformasjon og kommentarer\n• Teknisk informasjon: IP-adresse, nettlesertype og bruksmønster for å forbedre tjenesten\n• Cookies og lignende teknologier for å huske dine preferanser"
          }
        }
      }
    },
    "privacy.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This privacy policy describes how Drive Log (\"we\", \"us\", \"our\") collects, uses, and protects your personal information when you use our driving log service."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne personvernserklæringen beskriver hvordan Kjørelista (\"vi\", \"oss\", \"vår\") samler inn, bruker og beskytter dine personopplysninger når du bruker vår kjørelogg-tjeneste."
          }
        }
      }
    },
    "privacy.lastUpdated" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last updated: January 8, 2025"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sist oppdatert: 8. januar 2025"
          }
        }
      }
    },
    "privacy.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personvernserklæring"
          }
        }
      }
    },
    "privacy.userRights" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your rights"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine rettigheter"
          }
        }
      }
    },
    "privacy.userRightsContent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the right to:\n\n• Access your personal information\n• Correct incorrect or incomplete information\n• Delete your account and all associated data\n• Export your data in a machine-readable format\n• Withdraw consent where applicable\n• File a complaint with the data protection authority"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har rett til å:\n\n• Få tilgang til dine personopplysninger\n• Rette feil eller mangelfulle opplysninger\n• Slette din konto og alle tilknyttede data\n• Eksportere dine data i et maskinlesbart format\n• Trekke tilbake samtykke der det er relevant\n• Klage til Datatilsynet"
          }
        }
      }
    },
